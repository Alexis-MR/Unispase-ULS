---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Login — UniSpace ULS">
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />

  <div class="auth-page">
    <div class="auth-card">

      <div class="auth-brand">
        <span class="brand-icon">🎓</span>
        <h1>UniSpace <em>ULS</em></h1>
        <p>Inicia sesión para participar en la comunidad</p>
      </div>

      <div class="tabs">
        <button class="tab active" id="tab-login" onclick="switchTab('login')">Iniciar sesión</button>
        <button class="tab" id="tab-register" onclick="switchTab('register')">Registrarse</button>
      </div>

      <div id="msg" class="msg hidden"></div>

      <div id="form-login">
        <div class="field-group">
          <label>Correo electrónico</label>
          <input id="login-email" type="email" placeholder="tu@correo.com" />
        </div>
        <div class="field-group">
          <label>Contraseña</label>
          <div class="password-wrap">
            <input id="login-password" type="password" placeholder="••••••••" />
            <button type="button" class="toggle-pass" data-target="login-password" aria-label="Mostrar contraseña">👁️</button>
          </div>
        </div>
        <button class="btn-primary" id="btn-login">Iniciar sesión</button>
      </div>

      <div id="form-register" class="hidden">
        <div class="field-group">
          <label>Nombre completo</label>
          <input id="reg-nombre" type="text" placeholder="Tu nombre" />
        </div>
        <div class="field-group">
          <label>Correo electrónico</label>
          <input id="reg-email" type="email" placeholder="tu@correo.com" />
        </div>

        <div class="field-group">
          <label>Contraseña</label>
          <div class="password-wrap">
            <input id="reg-password" type="password" placeholder="Mínimo 6 caracteres" />
            <button type="button" class="toggle-pass" data-target="reg-password" aria-label="Mostrar contraseña">👁️</button>
          </div>
        </div>
        <button class="btn-primary" id="btn-register">Crear cuenta</button>
      </div>

      <div class="divider"><span>o continúa con</span></div>
<button class="btn-google" id="btn-google">
  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.875 2.684-6.615z" fill="#4285F4"/>
    <path d="M9 18c2.43 0 4.467-.806 5.956-2.184l-2.908-2.258c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z" fill="#34A853"/>
    <path d="M3.964 10.707A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.707V4.961H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.039l3.007-2.332z" fill="#FBBC05"/>
    <path d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.96L3.964 7.293C4.672 5.163 6.656 3.58 9 3.58z" fill="#EA4335"/>
  </svg>
  Continuar con Google
</button>

<button class="btn-forgot" id="btn-forgot">¿Olvidaste tu contraseña?</button>

<!-- Modal recuperar contraseña -->
<div id="modal-forgot" class="modal-overlay hidden">
  <div class="modal-box">
    <h3>Recuperar contraseña</h3>
    <p>Te enviaremos un enlace para restablecer tu contraseña.</p>
    <div class="field-group">
      <label>Correo electrónico</label>
      <input id="forgot-email" type="email" placeholder="tu@correo.com" />
    </div>
    <div id="forgot-msg" class="msg hidden"></div>
    <div class="modal-btns">
      <button class="btn-cancel-modal" id="btn-cerrar-modal">Cancelar</button>
      <button class="btn-primary" id="btn-enviar-reset">Enviar enlace</button>
    </div>
  </div>
</div>


    </div>
  </div>
</Layout>

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
.divider {
  display: flex; align-items: center; gap: 0.8rem;
  margin: 1.2rem 0; color: rgba(255,255,255,0.2); font-size: 0.78rem;
}
.divider::before, .divider::after {
  content: ''; flex: 1; height: 1px; background: rgba(255,255,255,0.08);
}

.btn-google {
  width: 100%; display: flex; align-items: center; justify-content: center; gap: 0.7rem;
  background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);
  border-radius: 12px; padding: 0.8rem; color: #fff;
  font-family: 'Syne', sans-serif; font-weight: 600; font-size: 0.9rem;
  cursor: pointer; transition: all 0.2s; margin-bottom: 0.8rem;
}
.btn-google:hover {
  background: rgba(255,255,255,0.09); border-color: rgba(255,255,255,0.2);
  transform: translateY(-1px);
}

.btn-forgot {
  width: 100%; background: none; border: none;
  color: rgba(255,255,255,0.35); font-size: 0.82rem;
  cursor: pointer; padding: 0.4rem; transition: color 0.2s;
  font-family: 'DM Sans', sans-serif;
}
.btn-forgot:hover { color: #60a5fa; }

.modal-overlay {
  position: fixed; inset: 0; z-index: 999;
  background: rgba(0,0,0,0.7); backdrop-filter: blur(6px);
  display: flex; align-items: center; justify-content: center; padding: 1.5rem;
}
.modal-box {
  background: #0e1421; border: 1px solid rgba(255,255,255,0.1);
  border-radius: 20px; padding: 2rem; width: 100%; max-width: 400px;
  display: flex; flex-direction: column; gap: 1rem;
  animation: fadeUp 0.25s ease;
}
.modal-box h3 { font-family: 'Syne', sans-serif; font-size: 1.2rem; font-weight: 800; }
.modal-box p { font-size: 0.85rem; color: rgba(255,255,255,0.4); }
.modal-btns { display: flex; gap: 0.7rem; justify-content: flex-end; margin-top: 0.3rem; }
.btn-cancel-modal {
  background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);
  color: rgba(255,255,255,0.5); border-radius: 10px; padding: 0.7rem 1.2rem;
  font-family: 'Syne', sans-serif; font-weight: 600; font-size: 0.85rem;
  cursor: pointer; transition: all 0.2s;
}
.btn-cancel-modal:hover { background: rgba(255,255,255,0.08); color: #fff; }
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(12px); }
  to   { opacity: 1; transform: translateY(0); }
}
  .auth-page {
    font-family: 'DM Sans', sans-serif;
    min-height: 100vh;
    background: #080c14;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    background-image: radial-gradient(ellipse at 50% 0%, rgba(37,99,255,0.12) 0%, transparent 60%);
  }

  .auth-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 24px;
    padding: 2.5rem;
    width: 100%;
    max-width: 420px;
  }

  .auth-brand { text-align: center; margin-bottom: 2rem; }
  .brand-icon { font-size: 2.5rem; display: block; margin-bottom: 0.75rem; }
  h1 {
    font-family: 'Syne', sans-serif;
    font-size: 1.8rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.5rem;
  }
  h1 em { font-style: italic; font-weight: 400; color: #60a5fa; }
  .auth-brand p { color: rgba(255,255,255,0.4); font-size: 0.88rem; }

  .tabs {
    display: flex;
    background: rgba(255,255,255,0.04);
    border-radius: 12px;
    padding: 4px;
    margin-bottom: 1.5rem;
    gap: 4px;
  }
  .tab {
    flex: 1;
    padding: 0.6rem;
    border: none;
    border-radius: 9px;
    background: transparent;
    color: rgba(255,255,255,0.4);
    font-family: 'Syne', sans-serif;
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  .tab.active { background: #2563ff; color: #fff; }

  .msg {
    padding: 0.75rem 1rem;
    border-radius: 10px;
    font-size: 0.85rem;
    margin-bottom: 1.2rem;
    text-align: center;
  }
  .msg.error { background: rgba(239,68,68,0.1); color: #f87171; border: 1px solid rgba(239,68,68,0.2); }
  .msg.success { background: rgba(34,197,94,0.1); color: #4ade80; border: 1px solid rgba(34,197,94,0.2); }

  .field-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }
  label {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.35);
  }
  input {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 10px;
    padding: 0.8rem 1rem;
    color: #fff;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    outline: none;
    width: 100%;
    transition: border-color 0.2s;
  }
  input:focus { border-color: rgba(37,99,255,0.6); background: rgba(37,99,255,0.04); }

  .btn-primary {
    width: 100%;
    background: #2563ff;
    color: #fff;
    border: none;
    padding: 0.85rem;
    border-radius: 12px;
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
    margin-top: 0.5rem;
    box-shadow: 0 0 30px rgba(37,99,255,0.3);
  }
  .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 6px 30px rgba(37,99,255,0.5); }
  .btn-primary:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }



  select {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 10px;
    padding: 0.8rem 1rem;
    color: #fff;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    outline: none;
    width: 100%;
    transition: border-color 0.2s;
    cursor: pointer;
  }
  select option { background: #111827; color: #fff; }
  select:focus { border-color: rgba(37,99,255,0.6); }
  .password-wrap { position: relative; }
  .password-wrap input { padding-right: 2.9rem; }
  .toggle-pass {
    position: absolute; right: 0.5rem; top: 50%; transform: translateY(-50%);
    background: none; border: none; cursor: pointer; font-size: 1.05rem;
    opacity: 0.55; padding: 0.35rem; line-height: 1; transition: opacity 0.2s;
  }
  .toggle-pass:hover { opacity: 1; }
  .hidden { display: none !important; }
</style>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  // Si ya está logueado, redirige
  const { data: { session } } = await supabase.auth.getSession();
  if (session) window.location.href = '/';

  function switchTab(tab) {
    document.getElementById('form-login').classList.toggle('hidden', tab !== 'login');
    document.getElementById('form-register').classList.toggle('hidden', tab !== 'register');
    document.getElementById('tab-login').classList.toggle('active', tab === 'login');
    document.getElementById('tab-register').classList.toggle('active', tab === 'register');
    hideMsg();
  }

  function showMsg(text, type = 'error') {
    const el = document.getElementById('msg');
    el.textContent = text;
    el.className = `msg ${type}`;
  }

  function hideMsg() {
    document.getElementById('msg').className = 'msg hidden';
  }

  window.switchTab = switchTab;

  // Toggle contraseña
  document.querySelectorAll('.toggle-pass').forEach((btn) => {
    btn.addEventListener('click', () => {
      const input = document.getElementById(btn.dataset.target);
      const visible = input.type === 'text';
      input.type = visible ? 'password' : 'text';
      btn.textContent = visible ? '👁️' : '🙈';
      btn.setAttribute('aria-label', visible ? 'Mostrar contraseña' : 'Ocultar contraseña');
    });
  });

  // LOGIN
  document.getElementById('btn-login').addEventListener('click', async () => {
    const email = document.getElementById('login-email').value.trim();
    const password = document.getElementById('login-password').value;
    if (!email || !password) { showMsg('Completa todos los campos'); return; }

    const btn = document.getElementById('btn-login');
    btn.textContent = 'Entrando...'; btn.disabled = true;

    const { error } = await supabase.auth.signInWithPassword({ email, password });

    if (error) {
      showMsg('Correo o contraseña incorrectos');
      btn.textContent = 'Iniciar sesión'; btn.disabled = false;
    } else {
      showMsg('¡Bienvenido! Redirigiendo...', 'success');
      setTimeout(() => window.location.href = '/', 1000);
    }
  });

  // GOOGLE
  document.getElementById('btn-google').addEventListener('click', async () => {
    const { error } = await supabase.auth.signInWithOAuth({
      provider: 'google',
      options: { redirectTo: window.location.origin + '/' }
    });
    if (error) showMsg('Error al conectar con Google');
  });

  // REGISTRO
  document.getElementById('btn-register').addEventListener('click', async () => {
    const nombre = document.getElementById('reg-nombre').value.trim();
    const email = document.getElementById('reg-email').value.trim();
    const password = document.getElementById('reg-password').value;
    if (!nombre || !email || !password) { showMsg('Completa todos los campos'); return; }
    if (password.length < 6) { showMsg('La contraseña debe tener al menos 6 caracteres'); return; }

    const btn = document.getElementById('btn-register');
    btn.textContent = 'Creando cuenta...'; btn.disabled = true;

    const { data: signUpData, error } = await supabase.auth.signUp({
      email, password,
      options: { data: { full_name: nombre } }
    });

    if (!error && signUpData.user) {
      await supabase.from('perfiles').upsert({
        id: signUpData.user.id,
        nombre,
        email,
      });
    }

    if (error) {
      showMsg(error.message);
      btn.textContent = 'Crear cuenta'; btn.disabled = false;
      return;
    }

    document.getElementById('reg-nombre').value = '';
    document.getElementById('reg-email').value = '';
    document.getElementById('reg-password').value = '';

    const { error: loginError } = await supabase.auth.signInWithPassword({ email, password });

    if (loginError) {
      showMsg('¡Cuenta creada! Inicia sesión.', 'success');
      btn.textContent = 'Crear cuenta'; btn.disabled = false;
    } else {
      showMsg('¡Bienvenido! Redirigiendo...', 'success');
      setTimeout(() => window.location.href = '/', 1000);
    }
  });

  // RECUPERAR CONTRASEÑA
  document.getElementById('btn-forgot').addEventListener('click', () => {
    document.getElementById('modal-forgot').classList.remove('hidden');
    document.getElementById('forgot-email').value = '';
    document.getElementById('forgot-msg').className = 'msg hidden';
  });

  document.getElementById('btn-cerrar-modal').addEventListener('click', () => {
    document.getElementById('modal-forgot').classList.add('hidden');
  });

  document.getElementById('modal-forgot').addEventListener('click', (e) => {
    if (e.target === e.currentTarget) e.currentTarget.classList.add('hidden');
  });

  document.getElementById('btn-enviar-reset').addEventListener('click', async () => {
    const email = document.getElementById('forgot-email').value.trim();
    const msgEl = document.getElementById('forgot-msg');

    if (!email) {
      msgEl.textContent = 'Ingresa tu correo';
      msgEl.className = 'msg error';
      return;
    }

    const btn = document.getElementById('btn-enviar-reset');
    btn.textContent = 'Enviando...'; btn.disabled = true;

    const { error } = await supabase.auth.resetPasswordForEmail(email, {
      redirectTo: window.location.origin + '/reset-password'
    });

    if (error) {
      msgEl.textContent = 'Error al enviar. Verifica el correo.';
      msgEl.className = 'msg error';
    } else {
      msgEl.textContent = '✓ Enlace enviado, revisa tu bandeja de entrada.';
      msgEl.className = 'msg success';
      setTimeout(() => document.getElementById('modal-forgot').classList.add('hidden'), 3000);
    }

    btn.textContent = 'Enviar enlace'; btn.disabled = false;
  });
</script>