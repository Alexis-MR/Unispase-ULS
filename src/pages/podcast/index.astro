---
import Layout from '../../layouts/Layout.astro';
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---

<Layout title="Podcast — UniSpace ULS">
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet" />

  <div class="page">

    <div class="hero-strip">
      <div class="waveform">
        {Array.from({length: 32}).map((_, i) => (
          <span class="bar" style={`--i:${i}`}></span>
        ))}
      </div>
      <div class="hero-text">
        <p class="tag">UNISPACE · AUDIO</p>
        <h1>Podcast <em>ULS</em></h1>
        <p class="sub">Voces universitarias. Ideas que importan.</p>
      </div>
      <button id="btn-nuevo" class="add-btn" style="visibility:hidden">
        <span class="plus">+</span>
        <span>Nuevo episodio</span>
      </button>
    </div>

    <div id="form-podcast" class="drawer">
      <div class="drawer-inner">
        <h3>Publicar episodio</h3>
        <div class="fields">
          <div class="field-group">
            <label>Tu nombre</label>
            <input id="input-autor" type="text" placeholder="Ej. María López" />
          </div>
          <div class="field-group">
            <label>Título del episodio</label>
            <input id="input-titulo" type="text" placeholder="Dale un nombre memorable" />
          </div>
          <div class="field-group">
            <label>URL de YouTube o audio</label>
            <input id="input-url" type="text" placeholder="https://youtube.com/watch?v=..." />
          </div>
          <div class="field-group">
            <label>Categoría</label>
            <select id="input-categoria">
              <option value="general">General</option>
              <option value="academico">Académico</option>
              <option value="entretenimiento">Entretenimiento</option>
              <option value="noticias">Noticias</option>
            </select>
          </div>
          <div class="field-group">
            <label>Descripción</label>
            <textarea id="input-descripcion" placeholder="¿De qué trata este episodio?"></textarea>
          </div>
        </div>
        <div class="drawer-btns">
          <button id="btn-cancelar" class="cancel-btn">Cancelar</button>
          <button id="btn-publicar" class="publish-btn">Publicar episodio →</button>
        </div>
      </div>
    </div>

    <div class="content-area">
      <div class="section-label">
        <span class="dot"></span>
        <span id="episode-count">Episodios</span>
      </div>
      <div id="podcasts-lista" class="grid"></div>
    </div>

  </div>
</Layout>

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  .page {
    font-family: 'DM Sans', sans-serif;
    min-height: 100vh;
    background: #080c14;
    color: #fff;
  }

  /* ── HERO ── */
  .hero-strip {
    position: relative;
    overflow: hidden;
    padding: 3.5rem 3rem 2.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .waveform {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    gap: 3px;
    padding: 0 3rem;
    opacity: 0.12;
    pointer-events: none;
  }
  .bar {
    flex: 1;
    background: linear-gradient(to top, #2563ff, #60a5fa);
    border-radius: 3px;
    animation: wave 1.4s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * 0.04s);
    height: 60%;
  }
  @keyframes wave {
    from { transform: scaleY(0.3); }
    to   { transform: scaleY(1); }
  }

  .hero-text { position: relative; }
  .tag {
    font-family: 'Syne', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #2563ff;
    margin-bottom: 0.6rem;
  }
  h1 {
    font-family: 'Syne', sans-serif;
    font-size: clamp(2.8rem, 6vw, 5rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin-bottom: 0.8rem;
  }
  h1 em {
    font-style: italic;
    font-weight: 400;
    color: #60a5fa;
  }
  .sub {
    color: rgba(255,255,255,0.4);
    font-size: 0.95rem;
    font-weight: 300;
    letter-spacing: 0.02em;
  }

  .add-btn {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: #2563ff;
    color: #fff;
    border: none;
    padding: 0.85rem 1.6rem;
    border-radius: 100px;
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 0.9rem;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
    white-space: nowrap;
    box-shadow: 0 0 40px rgba(37,99,255,0.35);
  }
  .add-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 50px rgba(37,99,255,0.5); }
  .plus {
    font-size: 1.3rem;
    line-height: 1;
    display: inline-block;
    transition: transform 0.3s;
  }
  .add-btn:hover .plus { transform: rotate(90deg); }

  /* ── DRAWER ── */
  .drawer {
    background: rgba(255,255,255,0.025);
    border-bottom: 1px solid rgba(255,255,255,0.06);
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.45s cubic-bezier(0.4,0,0.2,1);
  }

  .drawer-inner {
    padding: 2.5rem 3rem;
    max-width: 820px;
  }
  .drawer-inner h3 {
    font-family: 'Syne', sans-serif;
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 1.8rem;
    color: rgba(255,255,255,0.9);
  }
  .fields { display: flex; flex-direction: column; gap: 1.1rem; }
  .field-group { display: flex; flex-direction: column; gap: 0.4rem; }
  label {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.35);
    text-transform: uppercase;
  }
  input, select, textarea {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 10px;
    padding: 0.8rem 1rem;
    color: #fff;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    outline: none;
    width: 100%;
    transition: border-color 0.2s;
  }
  input:focus, select:focus, textarea:focus {
    border-color: rgba(37,99,255,0.6);
    background: rgba(37,99,255,0.04);
  }
  textarea { min-height: 90px; resize: vertical; }
  select option { background: #0d1117; }

  .drawer-btns {
    display: flex;
    gap: 1rem;
    margin-top: 1.8rem;
  }
  .cancel-btn {
    background: transparent;
    color: rgba(255,255,255,0.4);
    border: 1px solid rgba(255,255,255,0.1);
    padding: 0.75rem 1.4rem;
    border-radius: 100px;
    cursor: pointer;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    transition: color 0.2s;
  }
  .cancel-btn:hover { color: #fff; }
  .publish-btn {
    background: #2563ff;
    color: #fff;
    border: none;
    padding: 0.75rem 1.8rem;
    border-radius: 100px;
    cursor: pointer;
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 0.9rem;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .publish-btn:hover { transform: translateY(-1px); box-shadow: 0 6px 30px rgba(37,99,255,0.5); }

  /* ── CONTENT ── */
  .content-area { padding: 3rem; }

  .section-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 2rem;
    font-family: 'Syne', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.3);
  }
  .dot {
    width: 6px; height: 6px;
    background: #2563ff;
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.7); }
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.5rem;
  }

  /* ── CARDS ── */
  .podcast-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 20px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s, border-color 0.25s, box-shadow 0.25s;
    animation: fadeUp 0.4s ease both;
  }
  .podcast-card:hover {
    transform: translateY(-4px);
    border-color: rgba(37,99,255,0.25);
    box-shadow: 0 20px 60px rgba(0,0,0,0.4);
  }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

.card-media {
    width: 100%;
    background: #0d1117;
    overflow: hidden;
    flex-shrink: 0;
  }
  .card-media iframe {
    width: 100%;
    aspect-ratio: 16/9;
    border: none;
    display: block;
  }
  .card-media audio {
    width: 100%;
    padding: 1.5rem 1rem;
    accent-color: #2563ff;
  }
  .no-media {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    font-size: 3rem;
    opacity: 0.15;
  }

  .card-body {
    padding: 1.4rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .card-link { text-decoration: none; color: inherit; cursor: pointer; }

  /* Categoría + fecha */
  .card-meta-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.85rem;
  }
  .cat-pill {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: rgba(37,99,255,0.15);
    color: #60a5fa;
    border: 1px solid rgba(37,99,255,0.2);
    padding: 0.2rem 0.65rem;
    border-radius: 100px;
  }
  .card-date {
    font-size: 0.72rem;
    color: rgba(255,255,255,0.25);
    font-weight: 300;
    letter-spacing: 0.03em;
  }

  /* Título */
  .card-titulo {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 1.05rem;
    line-height: 1.25;
    color: #fff;
    margin-bottom: 0.65rem;
    letter-spacing: -0.01em;
  }

  /* Descripción */
  .card-desc {
    color: rgba(255,255,255,0.45);
    font-size: 0.83rem;
    line-height: 1.7;
    margin-bottom: 1.2rem;
    font-weight: 300;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  /* Autor */
  .card-author {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255,255,255,0.06);
    margin-top: auto;
  }
  .author-avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: linear-gradient(135deg, #2563ff, #60a5fa);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 0.85rem;
    color: #fff;
    flex-shrink: 0;
  }
  .author-info {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .author-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.25);
    font-weight: 500;
  }
  .author-name {
    font-size: 0.85rem;
    font-weight: 600;
    color: rgba(255,255,255,0.8);
    font-family: 'Syne', sans-serif;
  }

  /* ── EMPTY / LOADING ── */
  .empty-state {
    grid-column: 1/-1;
    text-align: center;
    padding: 5rem 2rem;
    color: rgba(255,255,255,0.2);
  }
  .empty-state .icon { font-size: 3rem; margin-bottom: 1rem; opacity: 0.3; display: block; }
  .empty-state p { font-size: 0.9rem; }

  .loading-cards {
    grid-column: 1/-1;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.5rem;
  }
  .skeleton {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 20px;
    overflow: hidden;
    animation: shimmer 1.5s ease-in-out infinite alternate;
  }
  @keyframes shimmer {
    from { opacity: 0.4; }
    to   { opacity: 0.9; }
  }
  .sk-media { background: rgba(255,255,255,0.04); aspect-ratio: 16/9; }
  .sk-body { padding: 1.4rem 1.5rem; }
  .sk-line { background: rgba(255,255,255,0.06); border-radius: 6px; margin-bottom: 0.6rem; }
  .sk-title { height: 18px; width: 70%; }
  .sk-desc { height: 12px; width: 90%; }
  .sk-desc2 { height: 12px; width: 60%; }
  .sk-meta { height: 10px; width: 45%; margin-top: 0.8rem; }
</style>

<script>
  import { createClient } from '@supabase/supabase-js';
  
  var SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
  var SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  var supabase = createClient(SUPABASE_URL, SUPABASE_KEY);

  const drawer = document.getElementById('form-podcast');
  const add = document.getElementById('btn-nuevo');

  var rol = '';

  function mostrar (rol){
    if (rol=='admin' || rol=='docente') {
      add.style.visibility = 'visible';
    } else {
      add.style.visibility = 'hidden';
    }   
  };

  supabase.auth.getSession().then(function(result) {
    var session = result.data.session;
    if (session) {
      var currentUser = session.user;
      // Obtener rol del perfil
      supabase.from('perfiles').select('rol').eq('id', currentUser.id).single()
        .then(function(res) {
          if (res.data) rol = res.data.rol;
          mostrar(rol);
        })
        .catch(function() { initPage(); });
    } else {
      mostrar(null);
       add.addEventListener('click', function() {
        alert('Inicia sesión para publicar episodios');
       });
    }
  });

  drawer.style.maxHeight = '0';

    
  document.getElementById('btn-nuevo').addEventListener('click', () => {

    const isOpen = drawer.style.maxHeight !== '0px' && drawer.style.maxHeight !== '0';
    drawer.style.maxHeight = isOpen ? '0' : '700px';
  });

  document.getElementById('btn-cancelar').addEventListener('click', () => {
    drawer.style.maxHeight = '0';
  });

  document.getElementById('btn-publicar').addEventListener('click', crearPodcast);

  function getYouTubeId(url) {
    const m = url.match(/(?:youtube\.com\/(?:watch\?v=|embed\/)|youtu\.be\/)([a-zA-Z0-9_-]{11})/);
    return m ? m[1] : null;
  }

  function renderMedia(url) {
    if (!url) return '<div class="no-media">🎙️</div>';
    const ytId = getYouTubeId(url);
    if (ytId) {
      return `<iframe src="https://www.youtube.com/embed/${ytId}" allowfullscreen loading="lazy"></iframe>`;
    }
    return `<audio controls><source src="${url}" /></audio>`;
  }

  function skeletons() {
    return `<div class="loading-cards">${Array.from({length: 3}).map(() => `
      <div class="skeleton">
        <div class="sk-media"></div>
        <div class="sk-body">
          <div class="sk-line sk-title"></div>
          <div class="sk-line sk-desc"></div>
          <div class="sk-line sk-desc2"></div>
          <div class="sk-line sk-meta"></div>
        </div>
      </div>
    `).join('')}</div>`;
  }

  async function cargarPodcasts() {
    const lista = document.getElementById('podcasts-lista');
    lista.innerHTML = skeletons();

    try {
      const res = await fetch(`${SUPABASE_URL}/rest/v1/podcasts?order=created_at.desc`, {
        headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${SUPABASE_KEY}` }
      });
      const podcasts = await res.json();

      document.getElementById('episode-count').textContent =
        podcasts.length ? `${podcasts.length} episodio${podcasts.length !== 1 ? 's' : ''}` : 'Episodios';

      if (!podcasts.length) {
        lista.innerHTML = `
          <div class="empty-state">
            <span class="icon">🎙️</span>
            <p>No hay episodios aún. ¡Sé el primero en publicar!</p>
          </div>`;
        return;
      }

      lista.innerHTML = podcasts.map((p, i) => `
        <div class="podcast-card" style="animation-delay:${i * 0.07}s">
          <div class="card-media">${renderMedia(p.url_audio)}</div>
          <a class="card-body card-link" href="/podcast/${p.id}">

            <div class="card-meta-top">
              <span class="cat-pill">${p.categoria}</span>
              <span class="card-date">${new Date(p.created_at).toLocaleDateString('es-SV', {day:'numeric',month:'short',year:'numeric'})}</span>
            </div>

            <h2 class="card-titulo">${p.titulo}</h2>

            ${p.descripcion ? `<p class="card-desc">${p.descripcion}</p>` : ''}

            <div class="card-author">
              <div class="author-avatar">${p.autor.charAt(0).toUpperCase()}</div>
              <div class="author-info">
                <span class="author-label">Publicado por</span>
                <span class="author-name">${p.autor}</span>
              </div>
            </div>

          </a>
        </div>
      `).join('');

    } catch(e) {
      lista.innerHTML = `<div class="empty-state"><p>Error al cargar episodios.</p></div>`;
    }
  }

  async function crearPodcast() {
    const autor = document.getElementById('input-autor').value.trim();
    const titulo = document.getElementById('input-titulo').value.trim();
    const url_audio = document.getElementById('input-url').value.trim();
    const categoria = document.getElementById('input-categoria').value;
    const descripcion = document.getElementById('input-descripcion').value.trim();
    if (!autor || !titulo) { alert('Completa nombre y título'); return; }

    const btn = document.getElementById('btn-publicar');
    btn.textContent = 'Publicando...';
    btn.disabled = true;

    await fetch(`${SUPABASE_URL}/rest/v1/podcasts`, {
      method: 'POST',
      headers: {
        apikey: SUPABASE_KEY,
        Authorization: `Bearer ${SUPABASE_KEY}`,
        'Content-Type': 'application/json',
        Prefer: 'return=minimal'
      },
      body: JSON.stringify({ autor, titulo, url_audio, categoria, descripcion })
    });

    btn.textContent = 'Publicar episodio →';
    btn.disabled = false;
    drawer.style.maxHeight = '0';
    ['input-autor','input-titulo','input-url','input-descripcion'].forEach(id => {
      document.getElementById(id).value = '';
    });
    cargarPodcasts();
  }

  cargarPodcasts();
</script>