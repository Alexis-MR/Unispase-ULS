---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Restablecer contraseña — UniSpace ULS">
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />

  <div class="auth-page">
    <div class="auth-card">

      <div class="auth-brand">
        <span class="brand-icon">🔐</span>
        <h1>Nueva <em>contraseña</em></h1>
        <p>Escribe tu nueva contraseña para tu cuenta</p>
      </div>

      <div id="msg" class="msg hidden"></div>

      <div id="form-reset">
        <div class="field-group">
          <label>Nueva contraseña</label>
          <div class="password-wrap">
            <input id="new-password" type="password" placeholder="Mínimo 6 caracteres" />
            <button type="button" class="toggle-pass" data-target="new-password" aria-label="Mostrar contraseña">👁️</button>
          </div>
        </div>
        <div class="field-group">
          <label>Confirmar contraseña</label>
          <div class="password-wrap">
            <input id="new-password-2" type="password" placeholder="Repite la contraseña" />
            <button type="button" class="toggle-pass" data-target="new-password-2" aria-label="Mostrar contraseña">👁️</button>
          </div>
        </div>
        <button class="btn-primary" id="btn-reset">Guardar contraseña</button>
      </div>

      <a href="/login" class="volver-link">← Volver a iniciar sesión</a>

    </div>
  </div>
</Layout>

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  .auth-page {
    font-family: 'DM Sans', sans-serif;
    min-height: 100vh;
    background: #080c14;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    background-image: radial-gradient(ellipse at 50% 0%, rgba(37,99,255,0.12) 0%, transparent 60%);
  }

  .auth-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 24px;
    padding: 2.5rem;
    width: 100%;
    max-width: 420px;
  }

  .auth-brand { text-align: center; margin-bottom: 2rem; }
  .brand-icon { font-size: 2.5rem; display: block; margin-bottom: 0.75rem; }
  h1 {
    font-family: 'Syne', sans-serif;
    font-size: 1.8rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.5rem;
  }
  h1 em { font-style: italic; font-weight: 400; color: #60a5fa; }
  .auth-brand p { color: rgba(255,255,255,0.4); font-size: 0.88rem; }

  .msg {
    padding: 0.75rem 1rem;
    border-radius: 10px;
    font-size: 0.85rem;
    margin-bottom: 1.2rem;
    text-align: center;
  }
  .msg.error { background: rgba(239,68,68,0.1); color: #f87171; border: 1px solid rgba(239,68,68,0.2); }
  .msg.success { background: rgba(34,197,94,0.1); color: #4ade80; border: 1px solid rgba(34,197,94,0.2); }

  .field-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }
  label {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.35);
  }
  input {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 10px;
    padding: 0.8rem 1rem;
    color: #fff;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    outline: none;
    width: 100%;
    transition: border-color 0.2s;
  }
  input:focus { border-color: rgba(37,99,255,0.6); background: rgba(37,99,255,0.04); }

  .password-wrap { position: relative; }
  .password-wrap input { padding-right: 2.9rem; }
  .toggle-pass {
    position: absolute; right: 0.5rem; top: 50%; transform: translateY(-50%);
    background: none; border: none; cursor: pointer; font-size: 1.05rem;
    opacity: 0.55; padding: 0.35rem; line-height: 1; transition: opacity 0.2s;
  }
  .toggle-pass:hover { opacity: 1; }

  .btn-primary {
    width: 100%;
    background: #2563ff;
    color: #fff;
    border: none;
    padding: 0.85rem;
    border-radius: 12px;
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
    margin-top: 0.5rem;
    box-shadow: 0 0 30px rgba(37,99,255,0.3);
  }
  .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 6px 30px rgba(37,99,255,0.5); }
  .btn-primary:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

  .volver-link {
    display: block; text-align: center; margin-top: 1.4rem;
    color: rgba(255,255,255,0.4); font-size: 0.82rem; text-decoration: none; transition: color 0.2s;
  }
  .volver-link:hover { color: #60a5fa; }

  .hidden { display: none !important; }
</style>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  function showMsg(text, type = 'error') {
    const el = document.getElementById('msg');
    el.textContent = text;
    el.className = `msg ${type}`;
  }

  // Mostrar / ocultar contraseña
  document.querySelectorAll('.toggle-pass').forEach((btn) => {
    btn.addEventListener('click', () => {
      const input = document.getElementById(btn.dataset.target);
      const visible = input.type === 'text';
      input.type = visible ? 'password' : 'text';
      btn.textContent = visible ? '👁️' : '🙈';
      btn.setAttribute('aria-label', visible ? 'Mostrar contraseña' : 'Ocultar contraseña');
    });
  });

  // Al llegar desde el correo, Supabase crea una sesión de recuperación
  let sesionLista = false;

  supabase.auth.onAuthStateChange((event) => {
    if (event === 'PASSWORD_RECOVERY' || event === 'SIGNED_IN') {
      sesionLista = true;
    }
  });

  // Verificar que exista sesión de recuperación
  supabase.auth.getSession().then(({ data: { session } }) => {
    if (session) {
      sesionLista = true;
    } else {
      setTimeout(() => {
        if (!sesionLista) {
          showMsg('Este enlace no es válido o ya expiró. Solicita uno nuevo desde el login.');
        }
      }, 1500);
    }
  });

  // Guardar nueva contraseña
  document.getElementById('btn-reset').addEventListener('click', async () => {
    const pass1 = document.getElementById('new-password').value;
    const pass2 = document.getElementById('new-password-2').value;

    if (!pass1 || !pass2) { showMsg('Completa ambos campos'); return; }
    if (pass1.length < 6) { showMsg('La contraseña debe tener al menos 6 caracteres'); return; }
    if (pass1 !== pass2) { showMsg('Las contraseñas no coinciden'); return; }

    const btn = document.getElementById('btn-reset');
    btn.textContent = 'Guardando...';
    btn.disabled = true;

    const { error } = await supabase.auth.updateUser({ password: pass1 });

    if (error) {
      showMsg(error.message);
      btn.textContent = 'Guardar contraseña';
      btn.disabled = false;
    } else {
      showMsg('✅ Contraseña actualizada. Redirigiendo...', 'success');
      setTimeout(() => window.location.href = '/login', 1500);
    }
  });
</script>