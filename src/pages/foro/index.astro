---
import Layout from '../../layouts/Layout.astro';
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---

<Layout title="Foro — UniSpace ULS">
  <div class="foro-container">
    <div class="foro-header">
      <div>
        <h1>Foro Estudiantil</h1>
        <p>Comparte ideas, preguntas y recursos con tu comunidad</p>
      </div>
      <button id="btn-nuevo">+ Nueva publicación</button>
    </div>

    <div id="form-post" class="form-card hidden">
      <div class="form-title">
        <span>✏️</span>
        <h3>Nueva publicación</h3>
      </div>
      <div class="form-grid">
        <select id="input-categoria">
          <option value="general">General</option>
          <option value="academico">Académico</option>
          <option value="eventos">Eventos</option>
          <option value="deportes">Deportes</option>
        </select>
      </div>
      <input id="input-titulo" type="text" placeholder="Título de la publicación" />
      <textarea id="input-contenido" placeholder="¿Qué quieres compartir?"></textarea>
      <div class="upload-area">
        <input type="file" id="input-imagen" accept="image/*,video/*" multiple hidden />
        <div class="upload-placeholder" id="upload-placeholder" onclick="document.getElementById('input-imagen').click()">
          <span class="upload-icon">📎</span>
          <span>Adjuntar imágenes o videos</span>
          <span class="upload-hint">Puedes seleccionar varios archivos — JPG, PNG, GIF, MP4</span>
        </div>
        <div id="preview-container" class="preview-grid hidden"></div>
      </div>
      <div class="form-btns">
        <button id="btn-cancelar" class="btn-cancel">Cancelar</button>
        <button id="btn-publicar" class="btn-submit">🚀 Publicar</button>
      </div>
    </div>

    <div id="posts-lista"></div>
  </div>
</Layout>

<style>
  .foro-container { max-width: 800px; margin: 0 auto; padding: 3rem 1.5rem; }

  .foro-header {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 2.5rem;
  }
  .foro-header h1 { font-size: 2rem; font-weight: 800; margin-bottom: 0.3rem; }
  .foro-header p { color: rgba(255,255,255,0.4); font-size: 0.9rem; }
  .foro-header button {
    background: #2563ff; color: #fff; border: none;
    padding: 0.8rem 1.6rem; border-radius: 12px;
    font-weight: 700; cursor: pointer; font-size: 0.9rem;
    transition: all 0.2s; box-shadow: 0 4px 20px rgba(37,99,255,0.4);
    white-space: nowrap;
  }
  .foro-header button:hover { background: #1d4ed8; transform: translateY(-1px); }

  .form-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 20px; padding: 2rem;
    margin-bottom: 2.5rem;
    display: flex; flex-direction: column; gap: 1rem;
  }
  .form-title { display: flex; align-items: center; gap: 0.7rem; margin-bottom: 0.3rem; }
  .form-title span { font-size: 1.4rem; }
  .form-title h3 { font-size: 1.1rem; font-weight: 700; }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .form-card input, .form-card textarea, .form-card select {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px; padding: 0.8rem 1rem;
    color: #fff; font-family: 'Space Grotesk', sans-serif;
    font-size: 0.9rem; outline: none; width: 100%;
    transition: border-color 0.2s;
  }
  .form-card input:focus, .form-card textarea:focus, .form-card select:focus {
    border-color: rgba(37,99,255,0.5);
  }
  .form-card input::placeholder, .form-card textarea::placeholder { color: rgba(255,255,255,0.3); }
  .form-card textarea { min-height: 100px; resize: vertical; }
  .form-card select option { background: #111827; }

  .upload-area {
    border: 2px dashed rgba(255,255,255,0.1);
    border-radius: 12px; overflow: hidden; transition: border-color 0.2s;
  }
  .upload-area:hover { border-color: rgba(37,99,255,0.4); }
  .upload-placeholder {
    display: flex; flex-direction: column; align-items: center;
    gap: 0.4rem; padding: 1.5rem; cursor: pointer;
    color: rgba(255,255,255,0.4); font-size: 0.88rem; transition: color 0.2s;
  }
  .upload-placeholder:hover { color: rgba(255,255,255,0.7); }
  .upload-icon { font-size: 1.8rem; }
  .upload-hint { font-size: 0.75rem; color: rgba(255,255,255,0.25); }
  .preview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 0.75rem;
    padding: 1rem;
  }
  .preview-item {
    position: relative;
    aspect-ratio: 1;
    border-radius: 10px;
    overflow: hidden;
    background: #0d1117;
  }
  .preview-item img, .preview-item video {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
  }
  .preview-remove {
    position: absolute; top: 6px; right: 6px;
    background: rgba(0,0,0,0.75); color: #fff; border: none;
    border-radius: 50%; width: 24px; height: 24px; cursor: pointer;
    font-size: 0.75rem; display: flex; align-items: center; justify-content: center;
    transition: background 0.2s;
  }
  .preview-remove:hover { background: rgba(239,68,68,0.8); }
  .preview-add {
    aspect-ratio: 1;
    border: 2px dashed rgba(255,255,255,0.15);
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; color: rgba(255,255,255,0.3);
    font-size: 1.5rem; transition: all 0.2s;
  }
  .preview-add:hover { border-color: rgba(37,99,255,0.5); color: #60a5fa; }
  .form-btns { display: flex; gap: 0.8rem; justify-content: flex-end; }
  .btn-cancel {
    background: rgba(255,255,255,0.05); color: rgba(255,255,255,0.6);
    border: 1px solid rgba(255,255,255,0.1);
    padding: 0.7rem 1.4rem; border-radius: 12px;
    cursor: pointer; font-weight: 600; font-size: 0.9rem; transition: all 0.2s;
  }
  .btn-cancel:hover { background: rgba(255,255,255,0.08); color: #fff; }
  .btn-submit {
    background: #2563ff; color: #fff; border: none;
    padding: 0.7rem 1.6rem; border-radius: 12px;
    cursor: pointer; font-weight: 700; font-size: 0.9rem;
    transition: all 0.2s; box-shadow: 0 4px 15px rgba(37,99,255,0.3);
  }
  .btn-submit:hover { background: #1d4ed8; transform: translateY(-1px); }
  .btn-submit:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
  .hidden { display: none !important; }

  /* ===== POSTS ===== */
  .post-card {
    position: relative;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 24px;
    margin-bottom: 2rem;
    overflow: hidden;
    transition: all 0.3s;
    box-shadow: 0 4px 24px rgba(0,0,0,0.2);
  }
  .post-card::before {
    content: '';
    position: absolute; left: 0; top: 0; bottom: 0;
    width: 4px;
    background: linear-gradient(180deg, #2563ff, #7c3aed);
    border-radius: 4px 0 0 4px;
    z-index: 1;
  }
  .post-card:hover {
    border-color: rgba(37,99,255,0.3);
    transform: translateY(-4px);
    box-shadow: 0 16px 48px rgba(0,0,0,0.35);
  }

  .post-media img {
    width: 100%; max-height: 420px;
    object-fit: cover; display: block;
  }
  .post-media video { width: 100%; max-height: 420px; display: block; }

  .post-body { padding: 1.6rem 1.8rem 1.8rem 2.2rem; }

  .post-cat-row {
    display: flex; align-items: center; gap: 0.6rem;
    margin-bottom: 0.8rem;
  }
  .post-cat {
    font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;
    background: rgba(37,99,255,0.15); color: #60a5fa;
    padding: 0.28rem 0.85rem; border-radius: 999px;
    border: 1px solid rgba(37,99,255,0.25);
  }
  .post-num { font-size: 0.72rem; color: rgba(255,255,255,0.2); font-weight: 500; }

  .post-titulo {
    font-size: 1.3rem; font-weight: 800; line-height: 1.3;
    color: #fff; margin-bottom: 0.8rem;
    letter-spacing: -0.02em;
  }

  .post-contenido {
    color: rgba(255,255,255,0.5); font-size: 0.93rem;
    line-height: 1.8; margin-bottom: 1.4rem;
    padding-left: 1rem;
    border-left: 2px solid rgba(37,99,255,0.3);
  }

  .post-footer {
    display: flex; align-items: center;
    padding-top: 1rem;
    border-top: 1px solid rgba(255,255,255,0.06);
  }
  .author-block { display: flex; align-items: center; gap: 0.8rem; }
  .author-avatar {
    width: 36px; height: 36px; border-radius: 50%;
    background: linear-gradient(135deg, #2563ff, #7c3aed);
    display: flex; align-items: center; justify-content: center;
    font-size: 0.85rem; font-weight: 800; color: #fff;
    box-shadow: 0 2px 10px rgba(37,99,255,0.35); flex-shrink: 0;
  }
  .author-info { display: flex; flex-direction: column; gap: 0.15rem; }
  .author-name { font-size: 0.88rem; font-weight: 700; color: #e2e8f0; }
  .author-date { font-size: 0.72rem; color: rgba(255,255,255,0.3); }

  .loading { text-align: center; color: rgba(255,255,255,0.3); padding: 4rem; font-size: 0.95rem; }
</style>

<script>
  import { createClient } from '@supabase/supabase-js';

  const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
  const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  const supabase = createClient(SUPABASE_URL, SUPABASE_KEY);

  let currentUser = null;
  const { data: { session } } = await supabase.auth.getSession();
  if (session) currentUser = session.user;

  const btnNuevo = document.getElementById('btn-nuevo');
  if (!currentUser) {
    btnNuevo.textContent = '🔒 Inicia sesión para publicar';
    btnNuevo.style.background = 'rgba(255,255,255,0.06)';
    btnNuevo.style.border = '1px solid rgba(255,255,255,0.1)';
    btnNuevo.addEventListener('click', () => window.location.href = '/login');
  } else {
    btnNuevo.addEventListener('click', () => {
      document.getElementById('form-post').classList.toggle('hidden');
    });
  }

  document.getElementById('btn-cancelar').addEventListener('click', () => {
    document.getElementById('form-post').classList.add('hidden');
  });

  document.getElementById('btn-publicar').addEventListener('click', crearPost);

  // ── PREVIEWS ──
  let archivosSeleccionados = [];

  document.getElementById('input-imagen').addEventListener('change', (e) => {
    archivosSeleccionados = [...archivosSeleccionados, ...Array.from(e.target.files)];
    renderPreviews();
    e.target.value = '';
  });

  function renderPreviews() {
    const preview = document.getElementById('preview-container');
    const placeholder = document.getElementById('upload-placeholder');
    preview.innerHTML = '';

    if (archivosSeleccionados.length === 0) {
      preview.classList.add('hidden');
      placeholder.classList.remove('hidden');
      return;
    }

    placeholder.classList.add('hidden');
    preview.classList.remove('hidden');

    archivosSeleccionados.forEach((file, i) => {
      const url = URL.createObjectURL(file);
      const item = document.createElement('div');
      item.className = 'preview-item';

      const isVideo = file.type.startsWith('video/');
      const media = isVideo
        ? Object.assign(document.createElement('video'), { src: url })
        : Object.assign(document.createElement('img'), { src: url, alt: 'preview' });

      const removeBtn = document.createElement('button');
      removeBtn.className = 'preview-remove';
      removeBtn.textContent = '✕';
      removeBtn.onclick = () => {
        archivosSeleccionados.splice(i, 1);
        renderPreviews();
      };

      item.appendChild(media);
      item.appendChild(removeBtn);
      preview.appendChild(item);
    });

    const addMore = document.createElement('div');
    addMore.className = 'preview-add';
    addMore.textContent = '+';
    addMore.onclick = () => document.getElementById('input-imagen').click();
    preview.appendChild(addMore);
  }

  // ── CARGAR POSTS ──
  async function cargarPosts() {
    const lista = document.getElementById('posts-lista');
    lista.innerHTML = '<p class="loading">Cargando posts...</p>';
    try {
      const res = await fetch(`${SUPABASE_URL}/rest/v1/posts?order=created_at.desc`, {
        headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${SUPABASE_KEY}` }
      });
      const posts = await res.json();
      if (!posts.length) {
        lista.innerHTML = '<p class="loading">No hay publicaciones aún. ¡Sé el primero!</p>';
        return;
      }
      lista.innerHTML = posts.map((p, i) => `
        <div class="post-card">
          ${p.imagen_url ? `
            <div class="post-media">
              ${p.imagen_url.split(',').map(url =>
                url.match(/\.(mp4|webm|ogg)$/i)
                  ? `<video controls style="width:100%;max-height:400px;object-fit:contain;background:#000"><source src="${url}" /></video>`
                  : `<img src="${url}" alt="imagen" style="width:100%;max-height:500px;object-fit:contain;background:#000;cursor:pointer" onclick="this.style.maxHeight=this.style.maxHeight==='none'?'500px':'none'" />`
              ).join('')}
            </div>` : ''}
          <div class="post-body">
            <div class="post-cat-row">
              <span class="post-cat">${p.categoria}</span>
              <span class="post-num">#${String(i + 1).padStart(2, '0')}</span>
            </div>
            <div class="post-titulo">${p.titulo}</div>
            <div class="post-contenido">${p.contenido}</div>
            <div class="post-footer">
              <div class="author-block">
                <div class="author-avatar">${p.autor.charAt(0).toUpperCase()}</div>
                <div class="author-info">
                  <span class="author-name">${p.autor}</span>
                  <span class="author-date">${new Date(p.created_at).toLocaleDateString('es-SV', {day:'numeric', month:'short', year:'numeric'})}</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      `).join('');
    } catch(e) {
      lista.innerHTML = '<p class="loading">Error al cargar posts.</p>';
    }
  }

  // ── CREAR POST ──
  async function crearPost() {
    if (!currentUser) { window.location.href = '/login'; return; }

    const autor = currentUser.user_metadata?.full_name || currentUser.email.split('@')[0];
    const titulo = document.getElementById('input-titulo').value.trim();
    const categoria = document.getElementById('input-categoria').value;
    const contenido = document.getElementById('input-contenido').value.trim();
    if (!titulo || !contenido) { alert('Completa todos los campos'); return; }

    const btn = document.getElementById('btn-publicar');
    btn.textContent = 'Subiendo...';
    btn.disabled = true;

    const urls = [];
    for (const file of archivosSeleccionados) {
      const ext = file.name.split('.').pop();
      const fileName = `${Date.now()}-${Math.random().toString(36).slice(2)}.${ext}`;
      const { error } = await supabase.storage
        .from('posts-media')
        .upload(fileName, file, { contentType: file.type });
      if (!error) {
        const { data: urlData } = supabase.storage
          .from('posts-media')
          .getPublicUrl(fileName);
        urls.push(urlData.publicUrl);
      }
    }

    const imagen_url = urls.length > 0 ? urls.join(',') : null;

    await fetch(`${SUPABASE_URL}/rest/v1/posts`, {
      method: 'POST',
      headers: {
        apikey: SUPABASE_KEY,
        Authorization: `Bearer ${SUPABASE_KEY}`,
        'Content-Type': 'application/json',
        Prefer: 'return=minimal'
      },
      body: JSON.stringify({ autor, titulo, categoria, contenido, imagen_url })
    });

    btn.textContent = '🚀 Publicar';
    btn.disabled = false;
    archivosSeleccionados = [];
    document.getElementById('form-post').classList.add('hidden');
    document.getElementById('input-titulo').value = '';
    document.getElementById('input-contenido').value = '';
    renderPreviews();
    cargarPosts();
  }

  cargarPosts();
</script>