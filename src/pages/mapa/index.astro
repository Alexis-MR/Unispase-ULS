---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Mapa — UniSpace ULS">
  <div class="mapa-container">
    <div class="mapa-header">
      <h1>Mapa del Campus</h1>
      <p>Encuentra aulas, laboratorios y espacios de la universidad</p>
    </div>

    <div class="mapa-wrapper">
      <div class="lugares-lista">
        <h3>Lugares</h3>
        <div class="lugar-item activo" data-lat="13.9094" data-lng="-89.5599" data-nombre="Edificio Principal">
          🏛️ Edificio Principal
        </div>
        <div class="lugar-item" data-lat="13.9090" data-lng="-89.5595" data-nombre="Biblioteca">
          📚 Biblioteca
        </div>
        <div class="lugar-item" data-lat="13.9098" data-lng="-89.5603" data-nombre="Laboratorio de Cómputo">
          💻 Laboratorio de Cómputo
        </div>
        <div class="lugar-item" data-lat="13.9086" data-lng="-89.5590" data-nombre="Cafetería">
          🍽️ Cafetería
        </div>
        <div class="lugar-item" data-lat="13.9102" data-lng="-89.5608" data-nombre="Cancha Deportiva">
          ⚽ Cancha Deportiva
        </div>
        <div class="lugar-item" data-lat="13.9088" data-lng="-89.5601" data-nombre="Auditorio">
          🎭 Auditorio
        </div>
      </div>
      <div id="map"></div>
    </div>
  </div>
</Layout>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<style>
  .mapa-container { max-width: 1100px; margin: 0 auto; padding: 3rem 1.5rem; }
  .mapa-header { margin-bottom: 2rem; }
  .mapa-header h1 { font-size: 2rem; font-weight: 700; margin-bottom: 0.5rem; }
  .mapa-header p { color: rgba(255,255,255,0.5); font-size: 0.95rem; }

  .mapa-wrapper { display: grid; grid-template-columns: 240px 1fr; gap: 1.5rem; }

  .lugares-lista {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 16px; padding: 1.2rem;
    display: flex; flex-direction: column; gap: 0.5rem;
  }
  .lugares-lista h3 { font-size: 0.85rem; color: rgba(255,255,255,0.4); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.5rem; }

  .lugar-item {
    padding: 0.75rem 1rem; border-radius: 10px;
    cursor: pointer; font-size: 0.9rem;
    color: rgba(255,255,255,0.6);
    transition: all 0.2s;
    border: 1px solid transparent;
  }
  .lugar-item:hover { background: rgba(255,255,255,0.06); color: #fff; }
  .lugar-item.activo { background: rgba(37,99,255,0.15); color: #60a5fa; border-color: rgba(37,99,255,0.3); }

  #map { height: 500px; border-radius: 16px; border: 1px solid rgba(255,255,255,0.08); overflow: hidden; }
</style>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
  window.addEventListener('load', () => {
    const map = L.map('map').setView([13.9094, -89.5599], 17);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© OpenStreetMap'
    }).addTo(map);

    const iconoPersonalizado = L.divIcon({
      html: '📍',
      className: 'icono-mapa',
      iconSize: [30, 30],
      iconAnchor: [15, 30]
    });

    const lugares = document.querySelectorAll('.lugar-item');

    lugares.forEach(lugar => {
      const lat = parseFloat(lugar.dataset.lat);
      const lng = parseFloat(lugar.dataset.lng);
      const nombre = lugar.dataset.nombre;

      const marcador = L.marker([lat, lng], { icon: iconoPersonalizado })
        .addTo(map)
        .bindPopup(`<b>${nombre}</b>`);

      lugar.addEventListener('click', () => {
        lugares.forEach(l => l.classList.remove('activo'));
        lugar.classList.add('activo');
        map.setView([lat, lng], 18);
        marcador.openPopup();
      });
    });
  });
</script>